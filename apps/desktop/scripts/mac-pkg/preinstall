#!/bin/sh
set -eu

# Installer supplies the destination volume as its third argument.
target_root=${3:?Missing installation target volume}
cli_path="${target_root%/}/usr/local/bin/ternline-cli"
scripts_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -e "$cli_path" ] || [ -L "$cli_path" ]; then
  if [ -L "$cli_path" ] || [ ! -f "$cli_path" ] || ! /usr/bin/cmp -s "$cli_path" "$scripts_dir/ternline-cli"; then
    printf '%s\n' "Ternline cannot install: an unrelated or modified command exists at $cli_path. Move it before installing." >&2
    exit 1
  fi
fi
