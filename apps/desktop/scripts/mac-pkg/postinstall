#!/bin/sh
set -eu

target_root=${3:?Missing installation target volume}
scripts_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
launcher="${target_root%/}/Applications/Ternline.app/Contents/Resources/cli/ternline-cli"
if [ ! -x "$launcher" ]; then
  printf '%s\n' 'Ternline cannot install its command: the bundled CLI is missing or not executable.' >&2
  exit 1
fi

# Recheck after the application payload installs. Replace only our exact launcher.
/bin/sh "$scripts_dir/preinstall" "$@"
cli_dir="${target_root%/}/usr/local/bin"
/bin/mkdir -p "$cli_dir"
temporary=$(/usr/bin/mktemp "$cli_dir/.ternline-cli.XXXXXX")
trap '/bin/rm -f "$temporary"' EXIT HUP INT TERM
/usr/bin/install -m 755 "$scripts_dir/ternline-cli" "$temporary"
/bin/mv -f "$temporary" "$cli_dir/ternline-cli"
