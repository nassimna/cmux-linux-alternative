---
interface Props {
  name: 'arrow' | 'download' | 'github' | 'code' | 'remote' | 'document' | 'terminal' | 'browser'
  class?: string
}

const { name, class: className = 'size-5' } = Astro.props
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'arrow' && <path d="M5 12h14m-5-5 5 5-5 5" />}
  {name === 'download' && <path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" />}
  {name === 'code' && <path d="m8 6-6 6 6 6m8-12 6 6-6 6m-3-14-2 16" />}
  {name === 'remote' && (
    <>
      <rect x="3" y="3" width="18" height="7" rx="1" />
      <rect x="3" y="14" width="18" height="7" rx="1" />
      <path d="M7 6.5h.01M7 17.5h.01M12 10v4" />
    </>
  )}
  {name === 'document' && (
    <>
      <path d="M13 3H5v18h14V9Z" />
      <path d="M13 3v6h6M8 13h8m-8 4h6" />
    </>
  )}
  {name === 'terminal' && (
    <>
      <rect x="3" y="4" width="18" height="16" rx="2" />
      <path d="m7 9 3 3-3 3m6 0h4" />
    </>
  )}
  {name === 'browser' && (
    <>
      <rect x="3" y="4" width="18" height="16" rx="2" />
      <path d="M3 9h18M6 6.5h.01M9 6.5h.01" />
    </>
  )}
  {name === 'github' && (
    <path d="M9 20c-5 1-5-2-7-2m14 4v-4a3 3 0 0 0-1-2c4-.5 6-2 6-5a5 5 0 0 0-1-3 5 5 0 0 0 0-4s-1 0-4 2a14 14 0 0 0-8 0C5 4 4 4 4 4a5 5 0 0 0 0 4 5 5 0 0 0-1 3c0 3 2 4.5 6 5a3 3 0 0 0-1 2v4" />
  )}
</svg>
