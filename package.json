{
  "name": "agent-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Independent cross-platform workspace for agent-driven development",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "build": "pnpm build:sidecars && pnpm --filter @agent-workspace/desktop build",
    "build:service:debug": "cargo build -p agent-workspace-service -p agent-workspace-cli",
    "build:service": "cargo build --release -p agent-workspace-service -p agent-workspace-cli",
    "build:sidecars": "cargo build --release -p agent-workspace-service -p agent-workspace-cli",
    "dev": "pnpm build:service:debug && pnpm --filter @agent-workspace/desktop dev",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check",
    "generate:protocol": "cargo test -p agent-workspace-protocol export_bindings -- --nocapture",
    "lint": "pnpm lint:js && pnpm lint:rust",
    "lint:js": "eslint .",
    "lint:rust": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "package:linux": "pnpm build:service && pnpm --filter @agent-workspace/desktop package:linux",
    "package:linux:local": "pnpm build:service && pnpm --filter @agent-workspace/desktop package:linux:local",
    "package:linux:dir": "pnpm build:service && pnpm --filter @agent-workspace/desktop package:linux:dir",
    "package:mac": "pnpm build:service && pnpm --filter @agent-workspace/desktop package:mac",
    "package:mac:updates": "pnpm build:service && pnpm --filter @agent-workspace/desktop package:mac:updates",
    "package:mac:dir": "pnpm build:service && pnpm --filter @agent-workspace/desktop package:mac:dir",
    "package:windows": "pnpm build:service && pnpm --filter @agent-workspace/desktop package:windows",
    "package:windows:updates": "pnpm build:service && pnpm --filter @agent-workspace/desktop package:windows:updates",
    "package:windows:dir": "pnpm build:service && pnpm --filter @agent-workspace/desktop package:windows:dir",
    "release:validate": "node scripts/release/validate-release.mjs",
    "source:fingerprint": "node scripts/source-tree-fingerprint.mjs",
    "test:release": "node --test scripts/release/*.test.mjs",
    "test": "pnpm build:service:debug && pnpm build:service && pnpm test:rust && pnpm test:js",
    "test:js": "pnpm test:release && pnpm -r --if-present test",
    "test:rust": "cargo test --workspace --all-features",
    "typecheck": "pnpm -r --if-present typecheck",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
