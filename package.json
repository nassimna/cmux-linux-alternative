{
  "name": "agent-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Independent cross-platform workspace for agent-driven development",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "build": "pnpm build:node && pnpm --filter @agent-workspace/desktop build",
    "build:node": "pnpm --filter @agent-workspace/server build && pnpm --filter @agent-workspace/cli build",
    "stage:node:linux": "pnpm build:node && node scripts/stage-linux-node-runtime.mjs",
    "dev": "pnpm build:node && pnpm --filter @agent-workspace/desktop dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm lint:js",
    "lint:js": "eslint .",
    "package:linux": "pnpm stage:node:linux && pnpm --filter @agent-workspace/desktop package:linux",
    "package:linux:local": "pnpm stage:node:linux && pnpm --filter @agent-workspace/desktop package:linux:local",
    "package:linux:dir": "pnpm stage:node:linux && pnpm --filter @agent-workspace/desktop package:linux:dir",
    "release:validate": "node scripts/release/validate-release.mjs",
    "source:fingerprint": "node scripts/source-tree-fingerprint.mjs",
    "test:release": "node --test scripts/release/*.test.mjs",
    "test": "pnpm test:js",
    "test:js": "pnpm test:release && pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
